---
/** L'outil d'une page : un simulateur déclaratif de tool-specs.ts, le calendrier annuel ou la prochaine röd dag. */
import SpecTool from './calc/SpecTool';
import Kalender from './bt/Kalender';
import Nasta from './bt/Nasta';
import { route } from '../i18n/routes';
import type { Lang } from '../lib/format';
interface Props { kind: string; lang: Lang; arg?: Record<string, number | string>; idPrefix?: string }
const { kind, lang, arg, idPrefix = 't' } = Astro.props;
const methodHref = route('method', lang);
---
{kind === 'kalender' ? <Kalender client:load lang={lang} year={Number(arg?.ar ?? 2027)} methodHref={methodHref} idPrefix={idPrefix} />
  : kind === 'nasta' ? <Nasta client:load lang={lang} methodHref={methodHref} idPrefix={idPrefix} />
  : <SpecTool client:load kind={kind} lang={lang} arg={arg ? JSON.stringify(arg) : undefined} methodHref={methodHref} idPrefix={idPrefix} />}
