---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'semesterplanerare', h2: 'Leave planner', text: 'Year and number of leave days: readers see the best plan and every Swedish bridge day of the year, with the eves as an option.', t: 'Swedish leave planner', h: 980 },
  { name: 'roda-dagar', h2: 'Public holidays', text: 'The thirteen Swedish public holidays from 2025 to 2030 with weekday and week number, eves optional.', t: 'Public holidays in Sweden', h: 900 },
];
---
<PageLayout title="Embed Rödadag for Free: Leave Planner and Holidays" description="Embed the Swedish leave planner and public-holiday list for free with an iframe: copy the code once and new years and changed rules appear on their own." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed Rödadag</h1>
    <p class="mt-3 text-lg text-navy-700">For union branches, HR teams, parents' associations and local papers: copy once, new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the Swedish version replace <code>/embed/en/</code> with <code>/embed/sv/</code>. Terms: keep the source link under the tool visible, do not alter the tool; it is provided without warranty. What readers type stays on their device. Questions through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/semesterplanerare/`} title="Swedish leave planner" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
