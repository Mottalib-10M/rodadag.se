---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'SE Röda dagar: Publisher, Sources and Independence';
const description = 'Who publishes SE Röda dagar: Radif Partners, independent and with no travel offers. Where the Swedish holidays, eves, leave rules and school breaks come from.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About {SITE_NAMES[lang]}</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why the site exists</h2>
    <p>Every autumn many people in Sweden hand in their leave wishes for the next year and look for the bridge days. The usual lists name the holidays but do not say how a given number of leave days should be placed to get the most time off, mix up public holidays with eves, or stop at the current year. This site derives everything from the statutes, three years ahead, and shows school breaks only where the municipality has published them itself.</p>
    <h2>Who publishes it</h2>
    <p>The publisher is {AUTHOR_NAME}, a company that builds tools from public rules. {AUTHOR_NAME} is not an agency, a municipality or a trade union, has no link to the Swedish government and uses no coats of arms or official logos. The site sells no trips, hotels or diaries and carries no affiliate links.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the data comes from</h2>
    <p>The holidays are set by the <Fragment set:html={s('helgdagslag', 'Public Holidays Act (1989:253)')} />, leave-day counting by the <Fragment set:html={s('semesterlag', 'Annual Leave Act (1977:480)')} />, deadlines by the <Fragment set:html={s('lagstadgadtid', 'Act on Computing Statutory Time Limits (1930:173)')} /> and summer time by the <Fragment set:html={s('sommartid', 'Summer Time Ordinance (2001:127)')} />. The school year is framed by the <Fragment set:html={s('skolforordning', 'Education Ordinance')} />, and every school-break date comes from the municipality's own page, for example <Fragment set:html={s('kommun-goteborg', 'Gothenburg')} />. How we calculate is on the <a href={route('method', lang)}>method</a> page; how we correct, in the <a href={route('editorial', lang)}>editorial policy</a>.</p>
    <h2>Your data</h2>
    <p>Every tool runs in your browser. Year, leave days, dates and municipality are neither sent nor stored. There is no account and no form. Details in the <a href={route('privacy', lang)}>privacy policy</a>.</p>
    <h2>What the site does not do</h2>
    <p>It does not approve leave and does not know your collective agreement. Whether the eves are days off for you is in your contract; which study days a school has, the school knows.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> if a holiday, a school-break date or a week number is wrong.</p>
  </article>
</PageLayout>
